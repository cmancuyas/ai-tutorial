# 1. Copy this file and name the copy ".env"  (see README, Step 6)
# 2. Fill in your own values from the Azure portal
# 3. Never share or commit the .env file. This example file is safe to share.

# Your endpoint + "/openai/v1/" at the end, for example:
# https://my-ai-resource.openai.azure.com/openai/v1/
AI_ENDPOINT=https://your-resource-name.openai.azure.com/openai/v1/

# Key 1 from the Azure portal
AI_API_KEY=your-key-here

# The DEPLOYMENT name you chose when deploying the model (not always the model name)
AI_MODEL=your-deployment-name

# Price in US dollars per 1 million tokens, from the Azure pricing page
# for the model you deployed. Only used to show you the cost of each call.
PRICE_INPUT_PER_MILLION=0.40
PRICE_OUTPUT_PER_MILLION=1.60
